{
  "name": "seiri-ai-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "dev:ma": "concurrently -n api,vite -c blue,gray \"npm run server\" \"npm run dev\"",
