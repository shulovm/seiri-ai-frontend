<ns0:div xmlns:ns0="http://www.tei-c.org/ns/1.0" xmlns:ns1="http://history.state.gov/frus/ns/1.0" ns1:doc-dateTime-max="1904-02-13T23:59:59-05:00" ns1:doc-dateTime-min="1904-02-13T00:00:00-05:00" n="125" subtype="historical-document" type="document" xml:id="d125">
                        <ns0:head><ns0:hi rend="italic">Mr. <ns0:persName type="from">Conger</ns0:persName> to Mr.
                                    <ns0:persName type="to">Hay</ns0:persName>.</ns0:hi></ns0:head>
                        <ns0:opener><ns0:dateline rendition="#right"><ns0:placeName><ns0:hi rend="smallcaps">American Legation</ns0:hi>,<ns0:lb /><ns0:hi rend="italic">Peking,
                                        China</ns0:hi></ns0:placeName>, <ns0:date calendar="gregorian" when="1904-02-13"><ns0:hi rend="italic">February 13,
                                    1904</ns0:hi></ns0:date>.</ns0:dateline>
                            <ns0:seg rendition="#left">No. 1503.]</ns0:seg></ns0:opener>
                        <ns0:p><ns0:hi rend="smallcaps">Sir</ns0:hi>: I have the honor to confirm your telegram
                            received February 10.</ns0:p>
                        <ns0:p>The Chinese Government have readily consented, and I have sent
                            telegraphic instructions to Consul Miller to take charge of Japanese
                            interests in his jurisdiction in accordance with your instructions.</ns0:p>
                        <ns0:p>I have, etc.</ns0:p>
                        <ns0:closer><ns0:signed><ns0:hi rend="smallcaps">E. H. Conger</ns0:hi>.</ns0:signed></ns0:closer>
                    </ns0:div>
                    