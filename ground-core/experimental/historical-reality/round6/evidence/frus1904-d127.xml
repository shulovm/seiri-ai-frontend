<ns0:div xmlns:ns0="http://www.tei-c.org/ns/1.0" xmlns:ns1="http://history.state.gov/frus/ns/1.0" ns1:doc-dateTime-max="1904-02-24T23:59:59-05:00" ns1:doc-dateTime-min="1904-02-24T00:00:00-05:00" n="127" subtype="historical-document" type="document" xml:id="d127">
                        <ns0:head><ns0:hi rend="italic">Mr. <ns0:persName type="from">Conger</ns0:persName> to Mr.
                                    <ns0:persName type="to">Hay</ns0:persName>.</ns0:hi></ns0:head>
                        <ns0:opener><ns0:seg rendition="#center">[Telegram.—Paraphrase.]</ns0:seg></ns0:opener>
                        <ns0:opener><ns0:dateline rendition="#right"><ns0:placeName><ns0:hi rend="smallcaps">American Legation</ns0:hi>,<ns0:lb /><ns0:hi rend="italic">Peking</ns0:hi></ns0:placeName>, <ns0:date calendar="gregorian" when="1904-02-24"><ns0:hi rend="italic">February 24,
                                    1904</ns0:hi></ns0:date>.</ns0:dateline></ns0:opener>
                        <ns0:p>(Mr. Conger reports that according to telegraphic information the Russian
                            authorities refuse to give information to Mr. Miller concerning Japanese
                            subjects or permission for their representatives to have intercourse
                            with them.)</ns0:p>
                    </ns0:div>
                    