{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ground.ink/schemas/ground-core/state-patch/v0.1.5",
  "title": "GROUND Core StatePatch",
  "description": "Incremental update to ProjectState. Supports Reality ontic + Epistemic Core + Reference State + Objective Core ops.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1.0",
        "0.1.1",
        "0.1.2",
        "0.1.3",
        "0.1.4",
        "0.1.5"
      ]
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "extraction",
        "import",
        "human_review"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/patch_operation"
      }
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "patch_op": {
      "type": "string",
      "enum": [
        "upsert",
        "status_change",
        "delete"
      ]
    },
    "patch_entity": {
      "type": "string",
      "enum": [
        "project",
        "goal",
        "current_state",
        "blocker",
        "next_action",
        "decision",
        "hypothesis",
        "reference_doc",
        "observation",
        "judgment",
        "reality_entity",
        "reality_event",
        "reality_state",
        "epistemic_observation",
        "evidence",
        "claim",
        "claim_evidence_link",
        "reference_condition",
        "reality_objective",
        "objective_requirement",
        "objective_dependency"
      ]
    },
    "patch_operation": {
      "type": "object",
      "required": [
        "op",
        "entity",
        "entity_id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "$ref": "#/$defs/patch_op"
        },
        "entity": {
          "$ref": "#/$defs/patch_entity"
        },
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "status": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "upsert"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "payload"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "status_change"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "status"
            ]
          }
        }
      ]
    }
  }
}
