{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ground.ink/schemas/ground-core/project-state/v0.1.3",
  "title": "GROUND Core ProjectState",
  "description": "Project Graph / State Engine aggregate root with Reality Ontic + Epistemic Core I (Observation/Evidence/Claim).",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "goals",
    "current_state",
    "blockers",
    "next_actions",
    "decisions",
    "hypotheses",
    "reference_docs",
    "observations",
    "judgments",
    "goal_edges",
    "reality_entities",
    "reality_events",
    "reality_states",
    "epistemic_observations",
    "evidence",
    "claims",
    "claim_evidence_links",
    "extensions",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.3"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "current_state": {
      "$ref": "#/$defs/current_state"
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "reference_docs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference_doc"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "judgments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/judgment"
      }
    },
    "goal_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal_edge"
      }
    },
    "reality_entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reality_entity"
      }
    },
    "reality_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reality_event"
      }
    },
    "reality_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reality_state"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "epistemic_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/epistemic_observation"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "claim_evidence_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_evidence_link"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_uuid": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived",
        "completed"
      ]
    },
    "goal_status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "achieved",
        "deferred",
        "abandoned"
      ]
    },
    "blocker_severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "blocker_status": {
      "type": "string",
      "enum": [
        "open",
        "mitigated",
        "resolved",
        "accepted"
      ]
    },
    "next_action_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done",
        "cancelled"
      ]
    },
    "decision_status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "reversed"
      ]
    },
    "hypothesis_status": {
      "type": "string",
      "enum": [
        "untested",
        "testing",
        "validated",
        "invalidated"
      ]
    },
    "goal_edge_type": {
      "type": "string",
      "enum": [
        "subgoal_of",
        "depends_on",
        "blocks",
        "supports"
      ]
    },
    "reference_doc_kind": {
      "type": "string",
      "enum": [
        "design",
        "schema",
        "manual_run",
        "prompt_bible",
        "other"
      ]
    },
    "reference_doc_status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "observation_source": {
      "type": "string",
      "enum": [
        "manual",
        "field_test",
        "conversation",
        "system"
      ]
    },
    "judgment_outcome": {
      "type": "string",
      "enum": [
        "go",
        "stop",
        "revise",
        "hold"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "status",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "$ref": "#/$defs/project_status"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "parent_goal_id",
        "title",
        "description",
        "status",
        "priority",
        "sort_order",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "parent_goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "status": {
          "$ref": "#/$defs/goal_status"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "goal_edge": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "from_goal_id",
        "to_goal_id",
        "edge_type",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "from_goal_id": {
          "$ref": "#/$defs/uuid"
        },
        "to_goal_id": {
          "$ref": "#/$defs/uuid"
        },
        "edge_type": {
          "$ref": "#/$defs/goal_edge_type"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "current_state": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "primary_goal_id",
        "primary_next_action_id",
        "summary",
        "phase",
        "confidence",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "primary_goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "primary_next_action_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "phase": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/confidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "blocker": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "goal_id",
        "title",
        "description",
        "severity",
        "status",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "severity": {
          "$ref": "#/$defs/blocker_severity"
        },
        "status": {
          "$ref": "#/$defs/blocker_status"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "next_action": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "goal_id",
        "blocker_id",
        "depends_on_action_id",
        "title",
        "description",
        "status",
        "due_at",
        "sort_order",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "blocker_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "depends_on_action_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/next_action_status"
        },
        "due_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "goal_id",
        "title",
        "rationale",
        "alternatives_considered",
        "status",
        "decided_at",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rationale": {
          "type": "string",
          "maxLength": 4000
        },
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "status": {
          "$ref": "#/$defs/decision_status"
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "goal_id",
        "statement",
        "status",
        "evidence_for",
        "evidence_against",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "$ref": "#/$defs/hypothesis_status"
        },
        "evidence_for": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "evidence_against": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "reference_doc": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "title",
        "path",
        "kind",
        "summary",
        "status",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "$ref": "#/$defs/reference_doc_kind"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "$ref": "#/$defs/reference_doc_status"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "goal_id",
        "title",
        "body",
        "source",
        "observed_at",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "source": {
          "$ref": "#/$defs/observation_source"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "judgment": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "goal_id",
        "observation_id",
        "title",
        "outcome",
        "rationale",
        "decided_at",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "goal_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "observation_id": {
          "$ref": "#/$defs/nullable_uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "outcome": {
          "$ref": "#/$defs/judgment_outcome"
        },
        "rationale": {
          "type": "string",
          "maxLength": 4000
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "reality_entity": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "kind",
        "label",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attrs": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "reality_event": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "kind",
        "subject_ids",
        "occurred_at",
        "recorded_at",
        "summary",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "occurred_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "attrs": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "reality_state": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "subject_id",
        "kind",
        "value",
        "valid_from",
        "valid_until",
        "recorded_at",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "subject_id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "description": "Evolvable state body; not a Claim/Observation/Prediction"
        },
        "valid_from": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "epistemic_provenance": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "organization",
            "sensor",
            "satellite",
            "api",
            "document",
            "ai_model",
            "system"
          ]
        },
        "entity_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "epistemic_observation": {
      "type": "object",
      "required": [
        "id",
        "project_id",
