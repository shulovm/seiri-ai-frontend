{
  "name": "seiri-ai-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "dev:ma": "concurrently -n api,vite -c blue,gray \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "build:ma": "vite build",
    "start": "node server.js",
    "prod": "npm run build && node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:ground-core": "tsx --test ground-core/__tests__/**/*.test.ts",
    "ground-core": "tsx ground-core/cli.ts",
    "ground-core:owner": "tsx ground-core/owner-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@vercel/analytics": "^1.6.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "serverless-http": "^4.0.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
